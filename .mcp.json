{
  "servers": {
    "vault77-game": {
      "type": "stdio",
      "command": "node",
      "args": ["mcp/vault77-server.js"],
      "env": {
        "VAULT77_API_URL": "${VAULT77_API_URL:-https://api.atomicfizzcaps.xyz}",
        "VAULT77_API_KEY": "${VAULT77_API_KEY:-}"
      }
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.1.14",
        "${workspaceFolder}/backend",
        "${workspaceFolder}/public",
        "${workspaceFolder}/docs",
        "${workspaceFolder}/mcp"
      ]
    },
    "redis": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@redis/mcp-server"],
      "env": {
        "REDIS_URL": "${REDIS_URL:-redis://localhost:6379}"
      }
    },
    "cloudflare": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN:-}",
        "CLOUDFLARE_ACCOUNT_ID": "${R2_ACCOUNT_ID:-}"
      }
    },
    "solana": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@sendaifun/solana-mcp-server"],
      "env": {
        "RPC_URL": "${SOLANA_RPC:-https://api.devnet.solana.com}"
      }
    },
    "render": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "render-mcp"],
      "env": {
        "RENDER_API_KEY": "${RENDER_API_KEY:-}"
      }
    },
    "vercel": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@vercel/mcp-adapter"],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN:-}"
      }
    }
  }
}
