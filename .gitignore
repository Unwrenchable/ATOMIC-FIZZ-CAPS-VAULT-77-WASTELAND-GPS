# ============================
# Atomic Fizz Caps – Git Ignore
# ============================

# --- Node Backend ---
node_modules/
mcp/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment variables
.env
.env.local
.env.*.local
.env.testnet

# Build output
dist/
build/
.next/
out/

# Logs
logs/
*.log
*.out
*.err

# --- Solana / Anchor Program ---
target/
**/target/
*.so
*.a
*.rlib
*.d
*.o

# Anchor IDL + build artifacts
*.json.old
*.idl.json
*.ts.old

# Cargo
Cargo.lock
.cargo/
rustfmt.toml

# SBPF / Solana build junk
**/sbpf-solana-solana/
**/.fingerprint/
**/deps/
**/build/

# --- Redis ---
dump.rdb
*.rdb
*.aof

# --- Codespaces / VSCode / Visual Studio ---
.vscode/
.history/
*.code-workspace
.vs/

# --- OS / Editor Junk ---
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Frontend / Pip-Boy ---
public/*.map
public/*.tmp
public/*.cache
public/.DS_Store

# Ignore generated map tiles or test files
public/data/map/test
public/data/map/pois/empty

# --- Render / Deployment ---
# render.yaml - Now tracked for proper deployment configuration
.render/

# --- Game UI (Next.js) ---
game-ui/.next/
game-ui/node_modules/
game-ui/.turbo/
game-ui/.vercel/

# --- Backup & Temporary Files ---
*.patch
*.bak
*.backup
*.old
*.tmp
*~
test/
tool/
data-archive/

# --- Legacy / Unused Code ---
*legacy*
*archive*
*experimental*

# --- Grok-generated output files (do not commit) ---
generated_npcs_grok.json
test_videos_output.json

# --- Root-level dev/test/generator scripts (not for production serving) ---
# These files live at the repo root for developer use only.
/test-*.html
/test-*.js
/generate_*.js
/generate-*.js
/create-*.js
/verify-*.js
/merge-*.js
/integrate_*.js

# --- Pre-baked NPC videos ---
# Small sets (e.g. one NPC ~50MB): commit MP4s and Vercel CDN serves them automatically.
# Large sets (all NPCs ~1GB+): host on Cloudflare R2/S3 and update paths in npc-videos.json.
# Uncomment the lines below to exclude MP4s from git if using external hosting:
# public/videos/npc/*.mp4
# public/videos/npc/*.webm
