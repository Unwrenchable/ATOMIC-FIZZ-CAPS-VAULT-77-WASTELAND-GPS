# ☢️ ATOMIC FIZZ CAPS - Environment Variables (Alphabetical)
# Do NOT commit real secrets to version control!
# See ENVIRONMENT_VARIABLES.md for detailed documentation

# Admin Configuration
ADMIN_PASSWORD=<ADMIN_PASSWORD>
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_USERNAME=admin
ADMIN_WALLETS=wallet1,wallet2

# AWS Configuration (optional, for KMS signing)
# See docs/AWS_KMS_SETUP.md for instructions on creating your KMS key
# AWS_REGION=us-west-2
# KMS_SIGNING_KEY_ID=arn:aws:kms:us-west-2:123456789012:key/abcd-efgh

# Client/Frontend Configuration
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Cooldown Settings
COOLDOWN_PREFIX=cooldown:
COOLDOWN_SECONDS=60
COOLDOWNS_FAIL_SAFE=deny
LOOT_COOLDOWN_SECONDS=300

# Game Secrets
GAME_VAULT_SECRET=<BASE58_SECRET>
GPS_SECRET=<BASE58_SECRET>
VOUCHER_KEY=v1
VOUCHER_SECRET=<BASE58_SECRET>
VOUCHER_TTL_SECONDS=3600
XP_KEY=xp_v1
XP_RATE=1.0
XP_SECRET=<BASE58_SECRET>

# GPS Configuration
GPS_DISTANCE_LIMIT=1000

# Hugging Face AI (Overseer)
HF_API_KEY=<YOUR_HF_API_KEY>
HF_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Helius API (optional, for NFT features)
HELIUS_API_KEY=<YOUR_HELIUS_API_KEY>

# NFT metadata storage (optional, IPFS)
# If set, mint worker uploads metadata JSON to IPFS and stores gateway URI on-chain.
# Priority order: NFT_STORAGE_API_KEY first, then PINATA_JWT.
# NFT.Storage: https://nft.storage/
# Pinata JWT: https://app.pinata.cloud/developers/api-keys
NFT_STORAGE_API_KEY=
PINATA_JWT=

# Model Configuration
MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
PORT=3000

# Redis Configuration
# IMPORTANT: Must use redis:// or rediss:// protocol (NOT http:// or https://)
# ❌ WRONG: REDIS_URL=http://localhost:6379
# ❌ WRONG: REDIS_URL=https://redis.example.com:6379
# ✅ CORRECT (standard): REDIS_URL=redis://default:password@localhost:6379
# ✅ CORRECT (TLS): REDIS_URL=rediss://default:password@redis.example.com:6380
REDIS_URL=redis://default:password@localhost:6379
# Set to true to enforce Redis in production (fails if connection fails)
# Set to false to allow in-memory fallback (not recommended for production, but more resilient)
# Default is false if not set
REQUIRE_REDIS_IN_PRODUCTION=false

# Server Security
SERVER_SECRET_KEY=<BASE58_64_BYTE_SECRET>
STRICT_REPLAY_PROTECTION=true

# Solana Configuration
SOLANA_RPC=https://api.mainnet-beta.solana.com
# SOLANA_NETWORK controls which Helius cluster is used for NFT fetching.
# Set to "mainnet-beta" for production, leave as "devnet" for testing.
SOLANA_NETWORK=mainnet-beta

# CAPS Token & Treasury (Atomic Fizz Caps ecosystem)
CAPS_MINT=<YOUR_CAPS_TOKEN_MINT_ADDRESS>
TOKEN_MINT=<YOUR_CAPS_TOKEN_MINT_ADDRESS>
TREASURY_WALLET=<YOUR_TREASURY_WALLET_ADDRESS>

# Fizz.fun Program (token launchpad) — OPTIONAL
# When not set, Fizz.fun automatically uses CAPS_MINT as the program identifier,
# creating a unified ecosystem where the CAPS SPL token address is the single
# on-chain identifier for both the token and the launchpad.
# Only set this if you deploy a separate, standalone Fizz.fun on-chain program.
# FIZZ_FUN_PROGRAM_ID=<SEPARATE_PROGRAM_ADDRESS_IF_NEEDED>

# xAI (Grok) NPC Video Generation — OPTIONAL
# Used by /api/npc/video/generate to create short Fallout-themed NPC videos.
# If not set, the endpoint returns a graceful "Video feed offline" message.
# Get your key at: https://console.x.ai/
XAI_API_KEY=

# Cloudflare R2 — NPC Video Hosting (required for pre-baked video pipeline)
# Free tier: 10GB storage, unlimited egress to the internet.
# Setup: https://dash.cloudflare.com/ → R2 → Create bucket named "atomicfizz-videos"
#        → Manage R2 API tokens → Create token with "Object Read & Write"
# Public URL: enable "Public access" on bucket → get your r2.dev subdomain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=atomicfizz-videos
R2_PUBLIC_URL=https://pub-XXXX.r2.dev
