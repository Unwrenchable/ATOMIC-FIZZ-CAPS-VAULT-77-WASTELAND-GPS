# ============================================================
# ATOMIC FIZZ CAPS - MAINNET PRODUCTION CONFIGURATION
# ============================================================
# This configuration is for mainnet deployment
# Production-ready with security restrictions
# ============================================================

# ------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------
# SOLANA NETWORK - MAINNET-BETA (Production)
# ------------------------------------------------------------
# Use mainnet-beta for production deployment
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Alternative: Use Helius for better reliability and performance
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
SOLANA_NETWORK=mainnet-beta

# ------------------------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------------------------
# Redis is REQUIRED for production player state and caching
REDIS_URL=redis://default:password@host:6379
REDIS_PREFIX=afw:
REQUIRE_REDIS_IN_PRODUCTION=true

# ------------------------------------------------------------
# HELIUS API (NFT Fetching & RPC)
# ------------------------------------------------------------
# Get API key from: https://helius.xyz/
HELIUS_API_KEY=your_helius_api_key_here

# NFT metadata storage (IPFS) — set one provider
# Preferred: NFT.Storage API key
NFT_STORAGE_API_KEY=
# Alternative: Pinata JWT
PINATA_JWT=

# ------------------------------------------------------------
# METAPLEX CONFIGURATION
# ------------------------------------------------------------
# Production mainnet addresses - UPDATE THESE BEFORE DEPLOYMENT

# Your NFT Collection Address (mainnet)
METAPLEX_COLLECTION_ADDRESS=your_mainnet_collection_address

# Token Mint Addresses (mainnet) - UPDATE THESE
CAPS_MINT=your_mainnet_caps_token_mint
TREASURY_WALLET=your_mainnet_treasury_wallet

# Fizz.fun Program ID (optional - set if using separate program)
# FIZZ_FUN_PROGRAM_ID=your_mainnet_fizz_fun_program_id

# ------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------
# Generate a secure random key for signing
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_SECRET_KEY=generate_a_secure_random_base64_key_here

# Admin credentials for dashboard access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

# Admin wallets (comma-separated) - PRODUCTION SECURITY
# Only these wallets can access admin endpoints
ADMIN_WALLETS=your_admin_wallet_1,your_admin_wallet_2

# Admin mint secret (for production minting control)
ADMIN_MINT_SECRET=your_secure_mint_secret

# ------------------------------------------------------------
# CORS & FRONTEND
# ------------------------------------------------------------
# Allowed origins for CORS (production domains only)
FRONTEND_ORIGIN=https://atomicfizzcaps.xyz,https://www.atomicfizzcaps.xyz

# ------------------------------------------------------------
# GAME SECRETS (Generate new ones for production)
# ------------------------------------------------------------
GAME_VAULT_SECRET=generate_new_secure_base58_secret
GPS_SECRET=generate_new_secure_base58_secret
VOUCHER_KEY=v1
VOUCHER_SECRET=generate_new_secure_base58_secret
XP_KEY=xp_v1
XP_SECRET=generate_new_secure_base58_secret

# ------------------------------------------------------------
# AI CONFIGURATION (Production keys required)
# ------------------------------------------------------------
HF_API_KEY=your_production_huggingface_key
XAI_API_KEY=your_production_xai_key

# ------------------------------------------------------------
# DEPLOYMENT URLs
# ------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=https://api.atomicfizzcaps.xyz