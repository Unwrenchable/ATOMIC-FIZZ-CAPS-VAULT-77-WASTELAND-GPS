{
  "name": "atomicfizzcaps-live",
  "version": "1.0.1",
  "description": "Atomic Fizz Caps - Wasteland GPS Geo-Game powered by Solana",
  "main": "backend/server.js",
  "type": "commonjs",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node tests/security.test.js",
    "test:load": "node tests/concurrent-load-test.js",
    "test:load:full": "node tests/concurrent-load-test.js --players 1000 --batch-size 50",
    "test:playtest": "node tests/playtest-agent.js",
    "mcp:install": "cd mcp && npm install",
    "mcp:start": "node mcp/vault77-server.js"
  },
  "keywords": [
    "solana",
    "geo-game",
    "nft",
    "fallout",
    "web3",
    "gps",
    "atomic-fizz",
    "spl-token",
    "random-encounters",
    "helius"
  ],
  "author": "Unwrenchable",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.1.8",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "node-fetch": "^2.7.0",
    "redis": "^5.10.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "wav-encoder": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3"
  }
}
