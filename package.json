{
  "name": "atomicfizzcaps-live",
  "version": "1.0.1",
  "description": "Atomic Fizz Caps - Wasteland GPS Geo-Game powered by Solana",
  "main": "backend/server.js",
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "gen:npcs:sidequest": "node generate_sidequest_npcs.js",
    "gen:world": "node generate_world.js",
    "gen:world:integrate": "node integrate_world.js",
    "realai:gen:npcs": "node scripts/realai/generate-npcs.js",
    "realai:gen:locations": "node scripts/realai/generate-locations.js",
    "realai:gen:lore": "node scripts/realai/generate-lore.js",
    "verify:hf": "node verify-hf-api-usage.js",
    "worker:mint": "node workers/mint_worker_stream.js",
    "worker:mint:list": "node workers/mint_worker.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node tests/security.test.js",
    "test:load": "node tests/concurrent-load-test.js",
    "test:load:full": "node tests/concurrent-load-test.js --players 1000 --batch-size 50",
    "test:playtest": "node tests/playtest-agent.cjs",
    "mcp:install": "cd mcp && npm install",
    "mcp:start": "node mcp/vault77-server.js"
  },
  "keywords": [
    "solana",
    "geo-game",
    "nft",
    "fallout",
    "web3",
    "gps",
    "atomic-fizz",
    "spl-token",
    "random-encounters",
    "helius"
  ],
  "author": "Unwrenchable",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@metaplex-foundation/js": "^0.20.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@solana/web3.js": "1.91.8",
    "bs58": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "node-fetch": "^2.7.0",
    "redis": "^5.10.0",
    "rpc-websockets": "7.11.0",
    "tweetnacl": "^1.0.3",
    "uuid": "8.3.2",
    "wav-encoder": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.41",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.59.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
