# ☢️ ATOMIC FIZZ CAPS BACKEND - Environment Variables (Alphabetical)
# Do NOT commit real secrets to version control!
# See ../ENVIRONMENT_VARIABLES.md for detailed documentation

# Admin Configuration
# ADMIN_PASSWORD supports both plain text (legacy) and bcrypt hashes (recommended)
# To generate a bcrypt hash: cd backend && node scripts/generate-admin-hash.js
# Example bcrypt hash: $2b$12$abcdefghijklmnopqrstuvwxyz123456789ABCDEFGHIJK
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_USERNAME=your-admin-username
ADMIN_WALLETS=your-comma-separated-admin-wallets

# AWS Configuration (optional, for KMS signing)
# See ../docs/AWS_KMS_SETUP.md for instructions on creating your KMS key
AWS_REGION=us-west-2
# On-chain vouchers require ED25519_SHA_512. Use a distinct key id per cluster.
KMS_SIGNING_ALGORITHM=ED25519_SHA_512
# KMS_SIGNING_KEY_ID_DEVNET=arn:aws:kms:us-west-2:123456789012:key/devnet-only
# Legacy unsuffixed KMS_SIGNING_KEY_ID is ignored for voucher v1.

# Logging and Auditing (optional)
AUDIT_S3_BUCKET=your-audit-bucket

# Client/Frontend Configuration
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Cooldown Settings
COOLDOWN_PREFIX=cooldown:
COOLDOWN_SECONDS=60
COOLDOWNS_FAIL_SAFE=deny
LOOT_COOLDOWN_SECONDS=300

# Game Secrets
GAME_VAULT_SECRET=your-game-vault-secret
GPS_SECRET=your-gps-secret
VOUCHER_KEY=your-voucher-key
VOUCHER_SECRET=your-voucher-secret
VOUCHER_TTL_SECONDS=300
XP_KEY=your-xp-key
XP_RATE=1.0
XP_SECRET=your-xp-secret

# GPS Configuration
GPS_DISTANCE_LIMIT=1000

# Hugging Face AI (Overseer)
HF_API_KEY=your-huggingface-api-key
HF_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Helius API (optional, for NFT features)
HELIUS_API_KEY=your-helius-api-key

# Model Configuration
MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Node Environment
NODE_ENV=development
PORT=4000

# Redis Configuration
REDIS_URL=redis://:your_redis_password@redis-host:6379
REQUIRE_REDIS_IN_PRODUCTION=true

# Server Security
# Legacy SERVER_SECRET_KEY is ignored for voucher v1. Set the cluster key instead.
# SERVER_SECRET_KEY_DEVNET=base58-64-byte-ed25519-secret
# SERVER_SECRET_KEY_LOCALNET=base58-64-byte-ed25519-secret
# SERVER_SECRET_KEY_MAINNET=base58-64-byte-ed25519-secret
STRICT_REPLAY_PROTECTION=true

# Solana Configuration
SOLANA_CLUSTER=devnet
FIZZCAPS_PROGRAM_ID=GvTeKyGiFqtpJn2cJQxFb2iPVCYotvnMjMZKGAnPgZkc
SOLANA_RPC=your-solana-rpc-url
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
# SOLANA_NETWORK controls which Helius cluster is used for NFT fetching.
# Set to "mainnet-beta" for production, leave as "devnet" for testing.
SOLANA_NETWORK=devnet
TOKEN_MINT=your-solana-token-mint

# CAPS Token & Treasury (Atomic Fizz Caps ecosystem)
CAPS_MINT=your-caps-token-mint-address
CAPS_COLLECTION_MINT=your-caps-collection-mint-address
CAPS_TOKEN_DECIMALS=9
TREASURY_WALLET=your-treasury-wallet-address
REALAI_SIGNER_PATH=./keys/realai_agent.json

# Fizz.fun Program (token launchpad)
# Devnet default: GvTeKyGiFqtpJn2cJQxFb2iPVCYotvnMjMZKGAnPgZkc
# Override only if deploying a different standalone Fizz.fun on-chain program.
# FIZZ_FUN_PROGRAM_ID=program-address
